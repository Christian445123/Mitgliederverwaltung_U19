# Vorlage: Kopiere diese Datei zu `.env` und trage die echten Werte ein.
# .env ist per .gitignore von Git ausgeschlossen - NIEMALS committen!

# ── Datenbank ─────────────────────────────────────────────────
DB_HOST=localhost
DB_NAME=mitglieddb
DB_USER=mitglied
DB_PASS=CHANGE_ME

# ── SMTP (E-Mail-Versand) ────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_ENCRYPTION=STARTTLS
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=verein@example.org

# ── Basis-URL (für Verifizierungs-Links, ohne abschließenden Slash) ──
BASE_URL=https://verein.example.org

# ── Sicherheit ────────────────────────────────────────────────
# true, wenn die Seite ausschließlich über HTTPS erreichbar ist (empfohlen)
FORCE_HTTPS_COOKIE=true
# Im Produktivbetrieb IMMER false - zeigt sonst Fehlerdetails öffentlich an
DEBUG=false

# ── Notfall-Zugang (optional, leer lassen = deaktiviert) ─────────
# Admin-Login OHNE Datenbank-Abfrage, z. B. falls die admins-Tabelle leer
# oder die DB nicht erreichbar ist. Hash erzeugen mit:
#   php bin/hash_password.php <passwort>
EMERGENCY_ADMIN_USERNAME=
EMERGENCY_ADMIN_PASSWORD_HASH=

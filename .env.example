# Vorlage: Kopiere diese Datei zu `.env` und trage die echten Werte ein.
# .env ist per .gitignore von Git ausgeschlossen - NIEMALS committen!

# ── Datenbank ─────────────────────────────────────────────────
DB_HOST=localhost
DB_NAME=mitglieddb
DB_USER=mitglied
DB_PASS=CHANGE_ME

# ── SMTP (E-Mail-Versand) ────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_ENCRYPTION=STARTTLS
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=verein@example.org
